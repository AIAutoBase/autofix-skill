      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "notes": "1) Rellena aquí los destinos de los canales que uses. 2) Activa (enable) el nodo de cada canal que quieras; vienen apagados los que piden credencial. 3) Las claves (OpenRouter, SMTP, Telegram, Slack, Discord, Twilio) van en Credentials de n8n.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "// 1-2-3: the error as logged, when, and the severity the app reported. No AI here.\nconst cfg = $('Config').first().json;\nconst b = $('Webhook').first().json.body || {};\nconst ev = b.event || {};\nconst a = b.analysis || {};\nconst lang = (cfg.lang || 'es').toLowerCase().startsWith('en') ? 'en' : 'es';\nconst L = lang === 'en'\n  ? { h1: 'Error (exactly as it appears in the log)', src: 'Where', h2: 'Date and time', h3: 'Severity (reported by the app)', tbd: 'to be determined' }\n  : { h1: 'Error (tal como aparece en el log)', src: 'Origen', h2: 'Fecha y hora', h3: 'Gravedad (reportada por la app)', tbd: 'por determinar' };\nconst error = ev.error || b.text || JSON.stringify(b);\nconst ts = ev.ts || new Date().toISOString();\nconst severity_in = a.severity || L.tbd;\nconst app = ev.app || 'app', host = ev.host || '?', source = ev.source || '?';\nconst md123 = [\n  `# AutoFix · ${app} (${host})`, '',\n  `## 1. ${L.h1}`, `- ${L.src}: ${source}`, '```', error, '```', '',\n  `## 2. ${L.h2}`, ts, '',\n  `## 3. ${L.h3}`, severity_in,\n].join('\\n');\nreturn [{ json: { app, host, source, ts, error, severity_in, summary_in: a.summary || '', lang, md123 } }];"
      },
      "name": "Reporte 1-2-3",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a senior support engineer. A beginner built this app and AutoFix caught an error. Read the report below and reply ONLY with a JSON object with these keys: \"cause\" (2-3 sentences: why this error happens), \"fix\" (3-6 numbered concrete steps to fix it, with commands or file names when useful, as one string with line breaks), \"severity\" (\"high\" if users are blocked or data is at risk, \"medium\" if a feature fails, \"low\" if cosmetic or noisy). Write cause and fix in the language with code {{ $json.lang }}. Do not invent file paths; if unsure, say so.\n\n{{ $json.md123 }}",
        "hasOutputParser": true
      },
      "name": "Análisis AI",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        660,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "model": "={{ $('Config').first().json.model }}",
        "options": {}
      },
      "name": "OpenRouter",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        620,
        520
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\"cause\": \"why it happens\", \"fix\": \"1. ...\\n2. ...\", \"severity\": \"high\"}"
      },
      "name": "JSON 4-5-6",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        800,
        520
      ]
    },
    {
      "parameters": {
        "jsCode": "// 4-5-6 from the AI (or a plain note if the AI step failed), then one item per channel; disabled channel nodes just drop theirs.\nconst cfg = $('Config').first().json;\nconst r = $('Reporte 1-2-3').first().json;\nconst out = ($json.output && typeof $json.output === 'object') ? $json.output : null;\nconst severity = ((out && out.severity) || r.severity_in || 'medium').toLowerCase();\nconst L = r.lang === 'en'\n  ? { why: 'Why it happens', fix: 'Recommended fix', sev: 'Severity', noai: 'No AI analysis (check the OpenRouter credential in n8n).', call: 'AutoFix alert for' }\n  : { why: 'Por qué ocurre', fix: 'Recomendación para arreglarlo', sev: 'Severidad', noai: 'Sin análisis de AI (revisa la credencial de OpenRouter en n8n).', call: 'Alerta de AutoFix para' };\nconst cause = out ? String(out.cause) : L.noai;\nconst fix = out ? String(out.fix) : '';\nconst md = `${r.md123}\\n\\n## 4. ${L.why}\\n${cause}\\n\\n## 5. ${L.fix}\\n${fix}\\n\\n## 6. ${L.sev}\\n${severity}\\n`;\nconst icon = { high: '🔴', medium: '🟡', low: '🟢' }[severity] || '⚪';\nconst firstLine = r.error.split('\\n')[0].slice(0, 100);\nconst title = `AutoFix - ${r.app}: ${firstLine}`;   // ASCII only: it travels in an HTTP header (ntfy)\nconst text = `${icon} AutoFix · ${r.app} (${r.host})\\n${L.sev}: ${severity}\\n${r.ts}\\n\\n${r.error.slice(0, 400)}\\n\\n${L.why}: ${cause}\\n\\n${L.fix}:\\n${fix}`.slice(0, 3800);\nconst say = `${L.call} ${r.app}. ${L.sev} ${severity}. ${cause}`.slice(0, 600)\n  .replace(/[<>&\"']/g, c => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '\"': '&quot;', \"'\": '&apos;' }[c]));\nconst fileName = `autofix-${r.app}-${r.ts.replace(/[:T]/g, '-').slice(0, 19)}.md`;\nconst html = text.replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));   // Telegram parse_mode=HTML; its Markdown chokes on backticks\nconst base = { app: r.app, host: r.host, ts: r.ts, severity, title, subject: `${icon} ${title}`, text, html, md, say, fileName };\nconst items = [];\nfor (const ch of ['email', 'telegram', 'whatsapp', 'slack', 'discord', 'sms', 'call', 'ntfy', 'webhook']) {\n  if (ch === 'call' && cfg.call_only_if_high && severity !== 'high') continue;\n  const it = { json: { ...base, channel: ch } };\n  if (ch === 'email') it.binary = { report: { data: Buffer.from(md, 'utf8').toString('base64'), mimeType: 'text/markdown', fileName } };\n  items.push(it);\n}\nreturn items;"
      },
      "name": "Reporte final",
