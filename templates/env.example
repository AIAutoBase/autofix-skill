# ---------- AutoFix ----------
# Leave a channel empty to turn it off. Never commit this file with real values.
AUTOFIX_APP=my-app
AUTOFIX_LANG=es                      # es | en  (language of the explanations)

# AI that explains the error: anthropic | openai | openrouter | ollama  (empty = alerts without explanation)
AUTOFIX_LLM=anthropic
AUTOFIX_LLM_KEY=                     # not needed for ollama
AUTOFIX_LLM_MODEL=                   # empty = default (claude-haiku-5-5 / gpt-5-mini / anthropic/claude-haiku-4.5 / gemma3:4b)
AUTOFIX_LLM_URL=                     # only for ollama on another machine, e.g. http://192.168.1.50:11434

# Telegram
AUTOFIX_TELEGRAM_TOKEN=
AUTOFIX_TELEGRAM_CHAT_ID=
# WhatsApp (Evolution API)
AUTOFIX_WHATSAPP_URL=                # e.g. https://evolution.mydomain.com
AUTOFIX_WHATSAPP_INSTANCE=
AUTOFIX_WHATSAPP_KEY=
AUTOFIX_WHATSAPP_TO=                 # country code + number, no + or spaces: 17875551234
# Slack / Discord incoming webhooks
AUTOFIX_SLACK_WEBHOOK=
AUTOFIX_DISCORD_WEBHOOK=
# Any URL that accepts a JSON POST (n8n Webhook node, Make, Zapier...)
AUTOFIX_WEBHOOK_URL=
# Email (Node apps also need: npm i nodemailer)
AUTOFIX_EMAIL_TO=
AUTOFIX_SMTP_HOST=                   # smtp.gmail.com
AUTOFIX_SMTP_PORT=587
AUTOFIX_SMTP_USER=
AUTOFIX_SMTP_PASS=                   # Gmail: an App Password, not your normal password
AUTOFIX_SMTP_FROM=

# Optional
AUTOFIX_RETENTION_DAYS=30
AUTOFIX_MAX_ALERTS_PER_HOUR=10
AUTOFIX_DIR=autofix-data             # serverless (Vercel, Netlify): /tmp/autofix-data
AUTOFIX_ENABLED=1                    # 0 turns AutoFix off
